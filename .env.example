# Copy this file to .env and fill in your own keys. Never commit .env.

# Required for the default setup (text-embedding-3-small and gpt-4o-mini).
OPENAI_API_KEY=

# Required. Stores the search index. The free Starter plan is enough.
PINECONE_API_KEY=

# Free options, used by the model comparison and configs/free.yaml.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional. Raises the Semantic Scholar rate limit when collecting papers.
SEMANTIC_SCHOLAR_API_KEY=
